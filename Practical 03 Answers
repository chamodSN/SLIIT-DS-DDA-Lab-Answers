ALTER TYPE Emp_t ADD MEMBER FUNCTION child_allowance RETURN NUMBER CASCADE;
/

CREATE OR REPLACE TYPE BODY Emp_t AS

    MEMBER FUNCTION child_allowance RETURN NUMBER IS
        child_count NUMBER := 0;
    BEGIN
        IF dependents IS NOT NULL THEN
            FOR i IN 1 .. dependents.COUNT LOOP
                IF dependents(i).relationship = 'CHILD' THEN
                    child_count := child_count + 1;
                END IF;
            END LOOP;
        END IF;

        RETURN salary * 0.05 * child_count;
    END;

END;
/


