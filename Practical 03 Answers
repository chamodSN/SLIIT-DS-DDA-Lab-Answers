CREATE TYPE Depend_t AS OBJECT (
    depname       VARCHAR2(12),
    gender        CHAR(1),
    bdate         DATE,
    relationship  VARCHAR2(10)
);
/

CREATE TYPE Dependtb_t AS TABLE OF Depend_t;
/

CREATE TYPE Dept_t;
/

CREATE TYPE Emp_t AS OBJECT (
    eno         NUMBER(4),
    ename       VARCHAR2(15),
    edept       REF Dept_t,
    salary      NUMBER(8,2),
    dependents  Dependtb_t
);
/

CREATE TYPE Dept_t AS OBJECT (
    dno    NUMBER(2),
    dname  VARCHAR2(12),
    mgr    REF Emp_t
);
/

CREATE TYPE Proj_t AS OBJECT (
    pno     NUMBER(4),
    pname   VARCHAR2(15),
    pdept   REF Dept_t,
    budget  NUMBER(10,2)
);
/

CREATE TYPE Work_t AS OBJECT (
    wemp   REF Emp_t,
    wproj  REF Proj_t,
    since  DATE,
    hours  NUMBER(4,2)
);
/

CREATE TABLE Dept OF Dept_t (
    dno PRIMARY KEY,
    dname NOT NULL
);

CREATE TABLE Emp OF Emp_t (
    eno PRIMARY KEY,
    ename NOT NULL,
    edept REFERENCES Dept,
    salary CHECK (salary > 0)
)
NESTED TABLE dependents STORE AS dependent_tb;

ALTER TABLE Dept
ADD CONSTRAINT dept_mgr_fk
FOREIGN KEY (mgr)
REFERENCES Emp;

CREATE TABLE Proj OF Proj_t (
    pno PRIMARY KEY,
    pname NOT NULL,
    pdept REFERENCES Dept,
    budget CHECK (budget > 0)
);

CREATE TABLE Works OF Work_t (
    wemp REFERENCES Emp,
    wproj REFERENCES Proj,
    since NOT NULL,
    hours CHECK (hours > 0)
);

CREATE OR REPLACE TRIGGER trg_check_dependents
BEFORE INSERT OR UPDATE ON Emp
FOR EACH ROW
DECLARE
  d Depend_t;
BEGIN
  FOR i IN 1 .. :NEW.dependents.COUNT LOOP
    d := :NEW.dependents(i);

    IF d.gender NOT IN ('M','F') THEN
      RAISE_APPLICATION_ERROR(-20001, 'Gender must be M or F');
    END IF;

    IF d.relationship NOT IN ('SPOUSE','CHILD') THEN
      RAISE_APPLICATION_ERROR(-20002, 'Relationship must be SPOUSE or CHILD');
    END IF;

    IF d.bdate > SYSDATE THEN
      RAISE_APPLICATION_ERROR(-20003, 'Birth date cannot be in the future');
    END IF;
  END LOOP;
END;
/

